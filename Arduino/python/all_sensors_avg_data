import serial
from datetime import datetime
import pandas as pd

baud_rate=115200
com_port='COM13'

total_sensors=2
max_samples=10
count=0 #count increases after 1 reading of every sensor

sensor1=[]
sensor2=[]
sensor3=[]
sensor4=[]
sensor5=[]
sensor6=[]

channels=["time", "415nm", "445nm", "480nm", "515nm", "555nm", "590nm", "630nm", "680nm", "Clear", "NIR"]

arduino=serial.Serial(port=com_port, baudrate=baud_rate, timeout=1)

def read_data(data):
    values = []

    # Extract sensor number
    try:
        sensor_label, data_part = data.split(':', 1)
        sensor_number = int(sensor_label.strip().split('#')[1])
    except:
        print("Could not parse sensor number")
        return None, None

    # Extract wavelength values
    parts = data_part.strip().split(',')
    for p in parts:
        try:
            key, val = p.split(':')
            values.append(int(val.strip()))
        except:
            print(f"Could not parse line: {p}")

    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    return sensor_number, [timestamp] + values

def data_list():

    global count

    while count<max_samples:

        decoded_data=arduino.readline().decode().strip()

        if 'Averaged sensor#' in decoded_data:
            sensor_number, reading = read_data(decoded_data)
            if reading is None: continue
            print(f"Sensor#{sensor_number}: ", reading)

            if sensor_number == 1:
                sensor1.append(reading)
            elif sensor_number == 2:
                sensor2.append(reading)
            elif sensor_number == 3:
                sensor3.append(reading)
            elif sensor_number == 4:
                sensor4.append(reading)
            elif sensor_number == 5:
                sensor5.append(reading)
            elif sensor_number == 6:
                sensor6.append(reading)

            if sensor_number == total_sensors:
                count += 1
                print(f"\nReading: {count}/{max_samples}\n")


    arduino.close()

    s1=pd.DataFrame(sensor1,columns=channels)
    s1.to_csv("s3R2Left15.csv", index=False)
    print("\nsaved to Sensor#1.csv\n")

    s2=pd.DataFrame(sensor2,columns=channels)
    s2.to_csv("s4R2Right14.csv", index=False)
    print("\nsaved to Sensor#2.csv\n")

