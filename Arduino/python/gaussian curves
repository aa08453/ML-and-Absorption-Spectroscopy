import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import norm
from matplotlib.ticker import MaxNLocator

name="sensor#"
channels=["415nm", "445nm", "480nm", "515nm", "555nm", "590nm", "630nm", "680nm", "Clear", "NIR"]
max_sensors=4
colors=[ "#c63465","#0f646f","#cc8d06","#632964","#20A156","#d77f1f","#44513A","#6c1749", "#c63465","#0f646f","#cc8d06","#632964","#20A156","#d77f1f","#44513A","#6c1749"]

#----------------------------------------------------------------4 sensor reading csv--------------------------------------------------------------
s1=pd.read_csv(f'{name}1.csv',usecols=channels)
s2=pd.read_csv(f'{name}2.csv',usecols=channels)
s3=pd.read_csv(f'{name}3.csv',usecols=channels)
s4=pd.read_csv(f'{name}4.csv',usecols=channels)
# s5=pd.read_csv(f'{name}5.csv',usecols=channels)
# s6=pd.read_csv(f'{name}6.csv',usecols=channels)

sensors=[s1,s2,s3,s4]
total_readings=s1['415nm'].values

for i in range(10):
    plt.figure(figsize=(14, 6))  # increase figure size
    all_values=[]
    for j in range(max_sensors):
        reading=sensors[j][channels[i]].values
        mu=np.mean(reading)
        std=np.std(reading)

        span = max(5 * std, 5)  # at least ±5 units wide
        x = np.linspace(mu - span, mu + span, 500)
        pdf = norm.pdf(x, loc=mu, scale=std)
        all_values.extend(reading)
        print(f"{channels[i]} | Sensor#{j+1} | μ = {mu:.2f}, σ = {std:.6f}, min = {min(reading)}, max = {max(reading)}")

        plt.plot(x, pdf, label=f'sensor {j+1}', color=colors[j])
        plt.plot(mu,norm.pdf(mu, loc=mu, scale=std), marker='o', label=f'mean{j+1}:{mu}', color=colors[j+2])
        plt.plot(mu + std, norm.pdf(mu + std, loc=mu, scale=std),marker='*', label=f'+1σsensor{j+1}:{round(std,2)} ',color=colors[j+4])
        plt.plot(mu - std, norm.pdf(mu - std, loc=mu, scale=std),marker='*', label=f'-1σsensor{j+1}:{round(std,2)}',color=colors[j+6])
        

   # X-axis range based on all sensor readings
    combined_min = min(all_values)
    combined_max = max(all_values)
    padding = (combined_max - combined_min) * 0.2
    plt.xlim(combined_min - padding, combined_max + padding)

    # X ticks every 10 units
    ticks = np.arange(int(combined_min - padding), int(combined_max + padding), 10)
    plt.gca().xaxis.set_major_locator(MaxNLocator(nbins=10, prune='both'))

    plt.xlabel("Value")
    plt.ylabel("Probability Density")
    plt.title(f"Normal Distribution for {channels[i]}")
    plt.grid(True)
    plt.legend()
    plt.tight_layout()
    plt.show()
