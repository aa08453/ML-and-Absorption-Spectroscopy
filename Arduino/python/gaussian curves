import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import norm
from matplotlib.ticker import MaxNLocator

name="sensor#"
channels=["415nm", "445nm", "480nm", "515nm", "555nm", "590nm", "630nm", "680nm", "Clear", "NIR"]
max_sensors=4
colors=[ "#c63465","#0f646f","#cc8d06","#632964","#20A156","#d77f1f","#44513A","#6c1749", "#c63465","#0f646f","#cc8d06","#632964","#20A156","#d77f1f","#44513A","#6c1749"]

#----------------------------------------------------------------4 sensor reading csv--------------------------------------------------------------
s1=pd.read_csv(f'{name}1.csv',usecols=channels)
s2=pd.read_csv(f'{name}2.csv',usecols=channels)
s3=pd.read_csv(f'{name}3.csv',usecols=channels)
s4=pd.read_csv(f'{name}4.csv',usecols=channels)
# s5=pd.read_csv(f'{name}5.csv',usecols=channels)
# s6=pd.read_csv(f'{name}6.csv',usecols=channels)

sensors=[s1,s2,s3,s4]
total_readings=s1['415nm'].values

for i in range(10):
    plt.figure(figsize=(12,6))
    
    for j in range(max_sensors):
        reading = sensors[j][channels[i]].values
        mu = np.mean(reading)
        std = np.std(reading)

        x = np.linspace(mu - 4 * std, mu + 4 * std, 500)
        pdf = norm.pdf(x, loc=mu, scale=std)

        plt.plot(x, pdf, label=f"Sensor {j+1}", color=colors[j])

        plt.plot(mu, norm.pdf(mu, mu, std), 'o', color=colors[j+2], label=f"Mean: {mu:.2f}")
        plt.plot(mu + std, norm.pdf(mu + std, mu, std), '*', color=colors[j+4], label=f"+1σ: {std:.2f}")
        plt.plot(mu - std, norm.pdf(mu - std, mu, std), '*', color=colors[j+6], label=f"-1σ: {std:.2f}")

    plt.xlabel("Mean Value (μ)")
    plt.ylabel("Probability Density")
    plt.title(f"Normalized Distributions for {channels[i]}")
    plt.grid(True)
    plt.legend(loc="center left", bbox_to_anchor=(1.02, 0.5), borderaxespad=0.) 
    plt.tight_layout()
 
    plt.show()
