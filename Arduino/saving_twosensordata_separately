import serial
import pandas as pd
import time

# Configure the serial connection
ser = serial.Serial('COM12', baudrate=115200, timeout=1)

labels = ["time", "415nm_F1", "445nm_F2", "480nm_F3", "515nm_F4",
          "555nm_F5", "590nm_F6", "630nm_F7", "680nm_F8", "CLEAR", "NIR"]

MAX_READINGS = 30
sensor1_data = []
sensor2_data = []

def parse_sensor_line(line):
    parts = line.strip().split(":")
    if len(parts) != 2:
        return None, None
    sensor_label = parts[0].strip()
    values = parts[1].strip().split(",")
    if len(values) != len(labels) - 1:
        return None, None
    return sensor_label, [time.time()] + list(map(int, values))

def main():
    print(f"Collecting {MAX_READINGS} readings per sensor...")
    count1 = count2 = 0

    while count1 < MAX_READINGS or count2 < MAX_READINGS:
        line = ser.readline().decode('utf-8', errors='ignore')
        if not line.startswith("Sensor#"):
            continue
        sensor_label, reading = parse_sensor_line(line)
        if sensor_label and reading:
            if sensor_label == "Sensor#1" and count1 < MAX_READINGS:
                sensor1_data.append(reading)
                count1 += 1
                print(f"Sensor#1: {count1}/{MAX_READINGS}", end="\r")
            elif sensor_label == "Sensor#2" and count2 < MAX_READINGS:
                sensor2_data.append(reading)
                count2 += 1
                print(f"Sensor#2: {count2}/{MAX_READINGS}", end="\r")

    ser.close()

    # Convert to DataFrames and save
    df1 = pd.DataFrame(sensor1_data, columns=labels)
    df2 = pd.DataFrame(sensor2_data, columns=labels)
    df1.to_csv("sensor1_readings.csv", index=False)
    df2.to_csv("sensor2_readings.csv", index=False)
    print("\nDone! Data saved to 'sensor1_readings.csv' and 'sensor2_readings.csv'.")

if __name__ == "_main_":
    main()
